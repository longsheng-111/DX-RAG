# DeepSeek API (OpenAI 兼容)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 通义千问 DashScope (图片型 PDF OCR)
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# 应用配置
APP_NAME=dx-rag-demo
VECTOR_COLLECTION=knowledge_chunks
VECTOR_PERSIST_DIR=backend/app/vector_db
UPLOAD_DIR=backend/uploads
EMBED_MODEL=BAAI/bge-small-zh-v1.5
MAX_CHUNK_SIZE=800
CHUNK_OVERLAP=120

# 检索相关性阈值（BGE 余弦相似度），低于此值认为检索结果不相关
RETRIEVAL_SIMILARITY_THRESHOLD=0.65

# 数据库连接串（阶段 1：PostgreSQL + pgvector；本机测试可用 sqlite:///<绝对路径>）
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dxrag
# 存储后端：file=现有文件存储（默认）；postgres=数据库存储
STORAGE_BACKEND=file

# 摄入任务队列（阶段 4：ARQ broker；docker-compose 内自动覆盖为 redis://redis:6379/0）
REDIS_URL=redis://localhost:6379/0
# running 任务超过该分钟数无心跳视为 worker 宕机，读取时标记 failed
INGEST_JOB_STALE_MINUTES=15
# LLM 全局并发上限（worker 与 API 共用，防并发打爆上游限额）
LLM_MAX_CONCURRENT=8
